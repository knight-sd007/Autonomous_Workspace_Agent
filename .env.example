# Application Security Access Key
APP_ACCESS_KEY=your_app_access_key_here

# Default AI Provider Selection (openai, gemini)
AI_PROVIDER=openai

# OpenAI Provider Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini

# Google Gemini Provider Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Workspace Sandbox Configuration
WORKSPACE_DIR=workspace
MAX_PYTHON_TIMEOUT_SECONDS=10
REQUIRE_HUMAN_CONFIRMATION_FOR_MUTATION=true
