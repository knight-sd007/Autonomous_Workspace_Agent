# ==============================================================================
# Autonomous Workspace Agent (P07) — Production Environment Configuration Template
# Copy this file to .env and configure appropriate values before deployment.
# ==============================================================================

# Public Host Port (Cloudflare Tunnel target: http://127.0.0.1:8007)
P07_HOST_PORT=8007

# Container Image Registry Tags
P07_INGRESS_IMAGE=knightprime007/p07-ingress:latest
P07_API_IMAGE=knightprime007/p07-api:latest
P07_AGENT_IMAGE=knightprime007/p07-agent-runtime:latest
P07_MCP_IMAGE=knightprime007/p07-mcp:latest

# Internal Service Authentication Key (Shared between API, Agent Runtime, and MCP)
INTERNAL_SERVICE_KEY=generate_a_secure_random_internal_key_here

# Default AI Provider Selection (offline, openai, gemini)
AI_PROVIDER=offline

# OpenAI Provider Configuration (Optional)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Google Gemini Provider Configuration (Optional)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Workspace Sandbox & Security Policies
WORKSPACE_DIR=/workspace
MAX_PYTHON_TIMEOUT_SECONDS=10
REQUIRE_HUMAN_CONFIRMATION_FOR_MUTATION=true
