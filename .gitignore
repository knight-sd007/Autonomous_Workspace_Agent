# Python ignore rules
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# Environment & Secrets
.env
.env.local
.env.*.local
*.pem
*.key
.streamlit/secrets.toml

# IDE and OS settings
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Frontend & Node artifacts
node_modules/
.svelte-kit/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# .NET artifacts
[Bb]in/
[Oo]bj/
*.user
*.userosscache
*.sln.docstates
.vs/

# Runtime logs and databases
*.log
*.db
*.sqlite
*.sqlite3

# Workspace directory runtime artifacts (preserve directory structure)
workspace/*
!workspace/.gitkeep
